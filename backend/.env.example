NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anonymous_chat?schema=public
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=anonymous-chat-backend
KAFKA_CHAT_MESSAGES_TOPIC=chat-messages
KAFKA_CHAT_EVENTS_TOPIC=chat-events
SERVER_ID=anonymous-chat-node-1
MESSAGE_RATE_LIMIT=5
MESSAGE_RATE_WINDOW_MS=1000
MESSAGE_MAX_LENGTH=500
SESSION_TTL_SECONDS=3600
MATCHMAKING_LOCK_SECONDS=2
